CXX = g++
CXXFLAGS = -Wall -g -std=c++20 -O2 -ftree-vectorize
REMAKE = remake

FILES = base camera color debug geometry image light linalg material mesh path sampler solid sdf

.PHONY: clean

palette: palette.cpp
	$(CXX) $(CXXFLAGS) $< -o $@

examples/%: examples/%.cpp $(addsuffix .o, $(FILES))
	$(CXX) $(CXXFLAGS) -I . $^ -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -MMD -MT dummy -MF $@.d $< -c -o $@
	$(REMAKE) -r < $@.d
	rm $@.d

clean:
	rm $(addsuffix .o, $(FILES))
